// Cloudflare Workers (docs/DEPLOYMENT.md §Cloudflare). Secrets are set in the
// Cloudflare dashboard (Variables and Secrets), never here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Workers project name in the Cloudflare dashboard.
  "name": "personal-financial-management",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-01",
  // Serve the app at https://personal-financial-management.<account>.workers.dev
  // (kept on by every deploy); per-version preview URLs stay off.
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "personal-financial-management" }],
  // Recurring transactions and housekeeping: 5 minutes past every hour (UTC).
  "triggers": { "crons": ["5 * * * *"] },
  // Run next to the database (Neon, US East) instead of next to each visitor:
  // a page makes several queries, each a round trip to the database.
  "placement": { "mode": "smart" },
  "observability": { "enabled": true },
  // Non-secret settings. Secrets (DATABASE_URL, AUTH_SECRET, CRON_SECRET) are
  // added in the dashboard: Settings → Variables and Secrets.
  "vars": {
    // Cloudflare's header with the visitor's real IP (per-IP rate limits).
    "TRUSTED_IP_HEADER": "cf-connecting-ip",
    // Auth.js uses the address the request came in on (any workers.dev or
    // custom domain), so AUTH_URL does not have to be set by hand.
    "AUTH_TRUST_HOST": "true",
  },
}
