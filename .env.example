# Environment variables for the Personal Finance app.
# Copy to .env for local development. Placeholder values only — never commit real secrets.
# Validated at startup by src/server/env.ts; the app names any missing or invalid variable.
#
# Files (all git-ignored except this one):
#   .env              shared by the app, Prisma CLI, tests and e2e
#   .env.development  loaded by `next dev` only — put development-only settings here
#                     (e.g. MAIL_TRANSPORT="console"), so production builds never see them

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Runtime connection used by the app: a least-privilege role that can read and
# write rows but cannot change the schema. Create it with prisma/sql/app-role.sql.
DATABASE_URL="postgresql://finance_app:change-me@localhost:5432/finance_dev?schema=public"

# Schema-owner connection used by Prisma CLI commands (migrate, studio, seed's
# schema checks). If unset, the CLI falls back to DATABASE_URL.
MIGRATION_DATABASE_URL="postgresql://finance:finance@localhost:5432/finance_dev?schema=public"

# Integration tests. The name MUST end in "_test": the suite truncates every table.
TEST_DATABASE_URL="postgresql://finance:finance@localhost:5432/finance_test?schema=public"

# End-to-end tests (Playwright). The name MUST end in "_e2e".
E2E_DATABASE_URL="postgresql://finance:finance@localhost:5432/finance_e2e?schema=public"

# ---------------------------------------------------------------------------
# Authentication (Auth.js)
# ---------------------------------------------------------------------------

# Encrypts session cookies. 32+ random characters. Rotating it signs everyone out.
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Public origin of the app. Required in production; it must be the https:// URL so
# cookies get the Secure flag and "__Secure-" prefix. Optional in development.
# AUTH_URL="https://finance.example.com"

# Set to "true" only when running behind a trusted reverse proxy that is not
# auto-detected and AUTH_URL is not set.
# AUTH_TRUST_HOST="true"

# Header your host sets to the real client IP (used for IP-based rate limits).
# Leave unset locally; unset disables IP limits (email limits still apply).
# Examples: "x-real-ip" (nginx), "cf-connecting-ip" (Cloudflare), "x-forwarded-for" (Vercel).
# TRUSTED_IP_HEADER=""

# ---------------------------------------------------------------------------
# Email (password recovery)
# ---------------------------------------------------------------------------

# "none"    — password recovery is disabled and hidden (default, and production
#             until an email provider is chosen: docs/PRD.md Q-12)
# "console" — development only: reset links are printed to the terminal.
#             Put this in .env.development, not .env.
# MAIL_TRANSPORT="none"

# Base URL used in emailed links. Required when MAIL_TRANSPORT is not "none".
# APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Local seed data (npm run db:seed)
# ---------------------------------------------------------------------------

# Password for the demo user demo@example.test (min 10 characters). If unset, the
# seed generates a random one and prints it once. Never used outside development.
# SEED_DEMO_PASSWORD=""

# ---------------------------------------------------------------------------
# Phase 7 — recurring transactions scheduler
# ---------------------------------------------------------------------------

# Shared secret the scheduler sends to /api/cron/recurring. 32+ random bytes.
# CRON_SECRET=""

# ---------------------------------------------------------------------------
# Testing tools (optional)
# ---------------------------------------------------------------------------

# Path to an already-installed Chromium for Playwright (CI images, cloud sandboxes).
# PLAYWRIGHT_CHROMIUM_EXECUTABLE="/opt/pw-browsers/chromium"

# Port for the e2e production server (default 3100).
# E2E_PORT="3100"

# Expose the /design-system reference page in a production build (always on in
# `npm run dev`). Set automatically by the e2e suite. Never enable in deployments.
# ENABLE_DESIGN_SYSTEM_PAGE="false"
